<header class="jv-heading" data-jovaa-reveal>
  {%- if eyebrow != blank -%}<span class="jv-heading__eyebrow">{{ eyebrow | escape }}</span>{%- endif -%}
  {%- if heading != blank -%}
    <h2 id="{{ id }}">{{ heading | escape }}</h2>
  {%- else -%}
    <h2 class="visually-hidden" id="{{ id }}">{{ eyebrow | default: subheading | default: 'Section' | escape }}</h2>
  {%- endif -%}
  {%- if subheading != blank -%}<div class="jv-heading__rule" aria-hidden="true">{{ subheading | escape }}</div>{%- endif -%}
  {%- if text != blank -%}<div class="rte">{{ text }}</div>{%- endif -%}
</header>
