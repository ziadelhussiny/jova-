{%- assign heading_id = 'JovaaContact-' | append: section.id -%}
<section{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handleize }}"{% endif %} class="jv-section jv-section--sand" aria-labelledby="{{ heading_id }}">
  <div class="jv-shell">
    {% render 'jovaa-heading', id: heading_id, eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading, text: section.settings.intro %}
    <div class="jv-grid jv-contact">
      <aside class="jv-contact__panel" aria-labelledby="JovaaContactInfo-{{ section.id }}" data-jovaa-reveal>
        <h2 id="JovaaContactInfo-{{ section.id }}">{{ section.settings.info_heading | escape }}</h2>
        <div class="jv-contact__list">
          {%- for block in section.blocks -%}
            {%- if block.settings.link != blank -%}<a class="jv-contact__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{%- else -%}<div class="jv-contact__item" {{ block.shopify_attributes }}>{%- endif -%}
              {% render 'jovaa-icon', icon: block.settings.icon %}
              <div>
                <strong>{{ block.settings.heading | escape }}</strong>
                {%- if block.settings.value != blank -%}<div>{{ block.settings.value | escape }}</div>{%- endif -%}
                {%- if block.settings.note != blank -%}<span>{{ block.settings.note | escape }}</span>{%- endif -%}
              </div>
            {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          {%- endfor -%}
        </div>
      </aside>

      <div class="jv-contact__panel" data-jovaa-reveal>
        <h2>{{ section.settings.form_heading | escape }}</h2>
        {%- form 'contact', class: 'jv-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="jv-form-status jv-form-status--success" role="status" tabindex="-1">{{ section.settings.success_message | escape }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="jv-form-status jv-form-status--error" role="alert" tabindex="-1">
              <p>{{ section.settings.error_message | escape }}</p>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="jv-field">
            <label for="ContactName-{{ section.id }}">{{ section.settings.name_label | escape }} <span aria-hidden="true">*</span></label>
            <input id="ContactName-{{ section.id }}" name="contact[name]" type="text" autocomplete="name" value="{{ form.name | escape }}" required>
          </div>
          <div class="jv-field">
            <label for="ContactEmail-{{ section.id }}">{{ section.settings.email_label | escape }} <span aria-hidden="true">*</span></label>
            <input id="ContactEmail-{{ section.id }}" name="contact[email]" type="email" autocomplete="email" autocapitalize="off" spellcheck="false" value="{{ form.email | escape }}" required>
          </div>
          <div class="jv-field">
            <label for="ContactPhone-{{ section.id }}">{{ section.settings.phone_label | escape }}</label>
            <input id="ContactPhone-{{ section.id }}" name="contact[phone]" type="tel" autocomplete="tel" inputmode="tel" value="{{ form.phone | escape }}">
          </div>
          <div class="jv-field">
            <label for="ContactTopic-{{ section.id }}">{{ section.settings.topic_label | escape }}</label>
            <select id="ContactTopic-{{ section.id }}" name="contact[topic]">
              <option value="General inquiry">General inquiry</option>
              <option value="Existing order">Existing order</option>
              <option value="Product inquiry">Product inquiry</option>
              <option value="Exchange or return">Exchange or return</option>
            </select>
          </div>
          <div class="jv-field jv-field--full">
            <label for="ContactMessage-{{ section.id }}">{{ section.settings.message_label | escape }} <span aria-hidden="true">*</span></label>
            <textarea id="ContactMessage-{{ section.id }}" name="contact[body]" required>{{ form.body | escape }}</textarea>
          </div>
          <div class="jv-field jv-field--full">
            <button class="jv-button" type="submit">{{ section.settings.submit_label | escape }} <span aria-hidden="true">←</span></button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JOVAA • Contact",
  "tag": "section",
  "class": "jovaa-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "GET IN TOUCH" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "text", "id": "subheading", "label": "English subtitle", "default": "WE'RE ALWAYS HERE" },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>The JOVAA team is ready to answer your questions and help you choose what feels right for you.</p>" },
    { "type": "text", "id": "info_heading", "label": "Contact information heading", "default": "Contact information" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send us a message" },
    { "type": "text", "id": "name_label", "label": "Name field label", "default": "Full name" },
    { "type": "text", "id": "email_label", "label": "Email field label", "default": "Email address" },
    { "type": "text", "id": "phone_label", "label": "Phone field label", "default": "Phone number" },
    { "type": "text", "id": "topic_label", "label": "Inquiry field label", "default": "Inquiry type" },
    { "type": "text", "id": "message_label", "label": "Message field label", "default": "Your message" },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Send message" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thank you for contacting us. We will reply as soon as possible." },
    { "type": "text", "id": "error_message", "label": "Error message", "default": "Please review the fields below and try again." }
  ],
  "blocks": [
    {
      "type": "contact_method", "name": "Contact method",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "phone",
          "options": [{ "value": "phone", "label": "Phone" }, { "value": "message", "label": "WhatsApp" }, { "value": "mail", "label": "Email" }, { "value": "clock", "label": "Hours" }]
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Call us" },
        { "type": "text", "id": "value", "label": "Value", "default": "+20 10 1234 5678" },
        { "type": "text", "id": "note", "label": "Note", "default": "10 AM to 10 PM" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "JOVAA • Contact",
      "blocks": [
        { "type": "contact_method" },
        { "type": "contact_method", "settings": { "icon": "message", "heading": "WhatsApp", "note": "Fast replies during business hours" } },
        { "type": "contact_method", "settings": { "icon": "mail", "heading": "Email address", "value": "support@jovaa.com", "note": "We reply within 24 hours" } },
        { "type": "contact_method", "settings": { "icon": "clock", "heading": "Customer care hours", "value": "Daily, 10 AM to 10 PM", "note": "Cairo time" } }
      ]
    }
  ]
}
{% endschema %}
