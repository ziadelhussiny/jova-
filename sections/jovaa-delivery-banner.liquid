{%- assign delivery_alt = section.settings.image.alt | default: section.settings.heading -%}
<section class="jv-delivery jv-delivery--{{ section.settings.layout }}" aria-labelledby="JovaaDelivery-{{ section.id }}" data-jovaa-reveal>
  <div class="jv-delivery__media">
    {%- if section.settings.image != blank -%}
      <picture>
        {%- if section.settings.mobile_image != blank -%}
          <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 480 }} 480w, {{ section.settings.mobile_image | image_url: width: 750 }} 750w" sizes="100vw">
        {%- endif -%}
        {{ section.settings.image
          | image_url: width: 2200
          | image_tag:
            widths: '750, 1100, 1500, 1920, 2200',
            sizes: '100vw',
            loading: 'lazy',
            alt: delivery_alt
        }}
      </picture>
    {%- else -%}
      {% render 'jovaa-fallback-image', image: 'jovaa-cairo.webp', mobile_image: 'jovaa-cairo-mobile.webp', alt: delivery_alt, sizes: '100vw' %}
    {%- endif -%}
  </div>
  <div class="jv-delivery__content">
    <div class="jv-delivery__content-inner">
      {%- if section.settings.eyebrow != blank -%}<span class="jv-hero__eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 id="JovaaDelivery-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.english_heading != blank -%}<span class="jv-hero__english" lang="en">{{ section.settings.english_heading | escape }}</span>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="jv-button jv-button--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JOVAA • Egypt delivery",
  "tag": "section",
  "class": "jovaa-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    {
      "type": "select", "id": "layout", "label": "Layout", "default": "overlay",
      "options": [{ "value": "overlay", "label": "Text over image" }, { "value": "split", "label": "Split image and text" }]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "LUXURY DELIVERS EVERYWHERE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Across all Egypt" },
    { "type": "text", "id": "english_heading", "label": "English subtitle", "default": "ACROSS ALL EGYPT" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Wherever you are in Egypt, we deliver quickly and securely to your door.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "JOVAA • Egypt delivery" }]
}
{% endschema %}
