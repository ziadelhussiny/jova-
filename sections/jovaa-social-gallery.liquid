{%- assign heading_id = 'JovaaSocial-' | append: section.id -%}
<section class="jv-section jv-section--compact" aria-labelledby="{{ heading_id }}">
  <div class="jv-shell">
    {% render 'jovaa-heading', id: heading_id, eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.handle %}
    <div class="jv-grid jv-social" style="--jv-columns: {{ section.settings.columns }};" data-jovaa-reveal>
      {%- for block in section.blocks -%}
        {%- assign social_alt = block.settings.image.alt | default: block.settings.label -%}
        {%- assign fallback_asset = 'jovaa-perfume.webp' -%}
        {%- assign fallback_mobile_asset = 'jovaa-perfume-mobile.webp' -%}
        {%- case block.settings.fallback_image -%}
          {%- when 'handbag' -%}{%- assign fallback_asset = 'jovaa-handbag.webp' -%}{%- assign fallback_mobile_asset = 'jovaa-handbag-mobile.webp' -%}
          {%- when 'editorial' -%}{%- assign fallback_asset = 'jovaa-editorial.webp' -%}{%- assign fallback_mobile_asset = 'jovaa-editorial-mobile.webp' -%}
          {%- when 'cairo' -%}{%- assign fallback_asset = 'jovaa-cairo.webp' -%}{%- assign fallback_mobile_asset = 'jovaa-cairo-mobile.webp' -%}
          {%- when 'hero' -%}{%- assign fallback_asset = 'jovaa-home-hero.webp' -%}{%- assign fallback_mobile_asset = 'jovaa-home-hero-mobile.webp' -%}
        {%- endcase -%}
        <a class="jv-social__item" href="{{ block.settings.link | default: section.settings.profile_link }}" {{ block.shopify_attributes }} aria-label="{{ block.settings.label | escape }}">
          {%- if block.settings.image != blank -%}
            <picture>
              {%- if block.settings.mobile_image != blank -%}
                <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 180 }} 180w, {{ block.settings.mobile_image | image_url: width: 360 }} 360w" sizes="17vw">
              {%- endif -%}
              {{ block.settings.image
                | image_url: width: 700
                | image_tag:
                  widths: '180, 260, 360, 520, 700',
                  sizes: '(max-width: 749px) 17vw, 17vw',
                  loading: 'lazy',
                  alt: social_alt
              }}
            </picture>
          {%- else -%}
            {% render 'jovaa-fallback-image', image: fallback_asset, mobile_image: fallback_mobile_asset, alt: social_alt, sizes: '(max-width: 749px) 17vw, 17vw' %}
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JOVAA • Social",
  "tag": "section",
  "class": "jovaa-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow us on Instagram" },
    { "type": "text", "id": "handle", "label": "Account handle", "default": "@jovaa.perfumes" },
    { "type": "url", "id": "profile_link", "label": "Profile link" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 3, "max": 8, "step": 1, "default": 6 }
  ],
  "blocks": [
    {
      "type": "image", "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        {
          "type": "select", "id": "fallback_image", "label": "Built-in fallback image", "default": "perfume",
          "options": [
            { "value": "perfume", "label": "Perfume" }, { "value": "handbag", "label": "Handbag" },
            { "value": "editorial", "label": "Editorial model" }, { "value": "cairo", "label": "Cairo" },
            { "value": "hero", "label": "Perfume and handbag" }
          ]
        },
        { "type": "text", "id": "label", "label": "Link description", "default": "View this post on Instagram" },
        { "type": "url", "id": "link", "label": "Post link" }
      ]
    }
  ],
  "presets": [
    { "name": "JOVAA • Social", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }] }
  ]
}
{% endschema %}
