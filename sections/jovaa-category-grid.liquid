{%- assign heading_id = 'JovaaCategories-' | append: section.id -%}
<section class="jv-section jv-section--compact" aria-labelledby="{{ heading_id }}">
  <div class="jv-shell">
    {%- if section.settings.heading != blank -%}
      {% render 'jovaa-heading', id: heading_id, eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}
    {%- else -%}
      <h2 class="visually-hidden" id="{{ heading_id }}">{{ section.settings.accessible_title | escape }}</h2>
    {%- endif -%}
    <div class="jv-grid jv-categories" style="--jv-columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        {%- assign category_alt = block.settings.image.alt | default: block.settings.heading -%}
        {%- assign fallback_asset = 'jovaa-perfume.webp' -%}
        {%- if block.settings.fallback_image == 'handbag' -%}{%- assign fallback_asset = 'jovaa-handbag.webp' -%}{%- endif -%}
        <article class="jv-category" {{ block.shopify_attributes }} data-jovaa-reveal>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image
              | image_url: width: 1400
              | image_tag:
                widths: '400, 600, 900, 1200, 1400',
                sizes: '(max-width: 749px) 100vw, 50vw',
                loading: 'lazy',
                alt: category_alt
            }}
          {%- else -%}
            <img src="{{ fallback_asset | asset_url }}" width="1456" height="1092" loading="lazy" alt="{{ category_alt | escape }}">
          {%- endif -%}
          <div class="jv-category__content">
            <h3>{{ block.settings.heading | escape }}</h3>
            {%- if block.settings.english_heading != blank -%}<p lang="en">{{ block.settings.english_heading | escape }}</p>{%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="jv-button jv-button--light" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JOVAA • Categories",
  "tag": "section",
  "class": "jovaa-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "accessible_title", "label": "Accessible title", "default": "Shop by category" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "English subtitle" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 1, "max": 4, "step": 1, "default": 2 }
  ],
  "blocks": [
    {
      "type": "category", "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select", "id": "fallback_image", "label": "Built-in fallback image", "default": "perfume",
          "options": [{ "value": "perfume", "label": "Perfume" }, { "value": "handbag", "label": "Handbag" }]
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Perfumes" },
        { "type": "text", "id": "english_heading", "label": "English subtitle", "default": "PERFUMES" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "JOVAA • Categories",
      "blocks": [{ "type": "category" }, { "type": "category", "settings": { "heading": "Handbags", "english_heading": "BAGS" } }]
    }
  ]
}
{% endschema %}
