{%- assign story_alt = section.settings.image.alt | default: section.settings.heading -%}
{%- assign fallback_asset = 'jovaa-editorial.webp' -%}
{%- case section.settings.fallback_image -%}
  {%- when 'cairo' -%}{%- assign fallback_asset = 'jovaa-cairo.webp' -%}
  {%- when 'perfume' -%}{%- assign fallback_asset = 'jovaa-perfume.webp' -%}
  {%- when 'handbag' -%}{%- assign fallback_asset = 'jovaa-handbag.webp' -%}
{%- endcase -%}
<section{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handleize }}"{% endif %} class="jv-section" aria-labelledby="JovaaStory-{{ section.id }}">
  <div class="jv-shell">
    <div class="jv-grid jv-story{% if section.settings.image_position == 'end' %} jv-story--reverse{% endif %}" data-jovaa-reveal>
      <div class="jv-story__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image
            | image_url: width: 1600
            | image_tag:
              widths: '500, 750, 1000, 1300, 1600',
              sizes: '(max-width: 749px) 100vw, 50vw',
              loading: 'lazy',
              alt: story_alt
          }}
        {%- else -%}
          <img src="{{ fallback_asset | asset_url }}" width="1536" height="1024" loading="lazy" alt="{{ story_alt | escape }}">
        {%- endif -%}
      </div>
      <div class="jv-story__content">
        {%- if section.settings.eyebrow != blank -%}<span class="jv-heading__eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        <h2 id="JovaaStory-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.english_heading != blank -%}<span class="jv-hero__english" lang="en">{{ section.settings.english_heading | escape }}</span>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div><a class="jv-button" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }}</a></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JOVAA • Story",
  "tag": "section",
  "class": "jovaa-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select", "id": "fallback_image", "label": "Built-in fallback image", "default": "editorial",
      "options": [
        { "value": "editorial", "label": "Editorial model" }, { "value": "cairo", "label": "Cairo" },
        { "value": "perfume", "label": "Perfume" }, { "value": "handbag", "label": "Handbag" }
      ]
    },
    {
      "type": "select", "id": "image_position", "label": "Image position", "default": "start",
      "options": [{ "value": "start", "label": "Start" }, { "value": "end", "label": "End" }]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "About us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our story" },
    { "type": "text", "id": "english_heading", "label": "English subtitle", "default": "OUR STORY" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>JOVAA was founded in Egypt from a genuine passion for fine fragrance and exceptional handbags. We believe every detail can create a more beautiful moment.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "JOVAA • Story" }]
}
{% endschema %}
