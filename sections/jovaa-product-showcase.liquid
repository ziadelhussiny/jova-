{%- assign selected_collection = section.settings.collection | default: collections.all -%}
{%- assign heading_id = 'JovaaProducts-' | append: section.id -%}
<section class="jv-section jv-section--paper" aria-labelledby="{{ heading_id }}">
  <div class="jv-shell">
    {% render 'jovaa-heading', id: heading_id, eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}

    <div class="jv-grid jv-products" style="--jv-columns: {{ section.settings.columns }};">
      {%- for product in selected_collection.products limit: section.settings.products_to_show -%}
        {%- assign product_image_alt = product.featured_image.alt | default: product.title -%}
        <article class="jv-product" data-jovaa-reveal>
          <div class="jv-product__media">
            {%- if product.featured_image != blank -%}
              {{ product.featured_image
                | image_url: width: 900
                | image_tag:
                  widths: '240, 360, 480, 640, 900',
                  sizes: '(max-width: 749px) calc(50vw - 15px), (max-width: 989px) 33vw, 25vw',
                  loading: 'lazy',
                  alt: product_image_alt
              }}
            {%- else -%}
              <div class="jv-media-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
            {%- endif -%}
            {%- if product.compare_at_price > product.price -%}<span class="jv-product__badge">{{ section.settings.sale_label | escape }}</span>{%- endif -%}
          </div>
          <h3 class="jv-product__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
          <div class="jv-product__price">
            {%- if product.price_varies -%}From {{ product.price_min | money }}{%- else -%}{{ product.price | money }}{%- endif -%}
          </div>
          {%- if section.settings.show_quick_add -%}
            {%- if product.available and product.has_only_default_variant -%}
              {%- form 'product', product -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button class="jv-button" type="submit" name="add">{{ section.settings.add_to_cart_label | escape }}</button>
              {%- endform -%}
            {%- else -%}
              <a class="jv-button" href="{{ product.url }}">{{ section.settings.choose_options_label | escape }}</a>
            {%- endif -%}
          {%- endif -%}
        </article>
      {%- else -%}
        {%- for index in (1..4) -%}
          {%- assign fallback_asset = 'jovaa-perfume.webp' -%}
          {%- assign fallback_title = 'JOVAA Signature Eau de Parfum' -%}
          {%- if index == 2 or index == 4 -%}
            {%- assign fallback_asset = 'jovaa-handbag.webp' -%}
            {%- assign fallback_title = 'JOVAA Timeless Handbag' -%}
          {%- endif -%}
          <article class="jv-product">
            <div class="jv-product__media"><img src="{{ fallback_asset | asset_url }}" width="700" height="875" loading="lazy" alt="{{ fallback_title }}"></div>
            <h3 class="jv-product__title">{{ fallback_title }}</h3>
            <div class="jv-product__price">From {{ 9500 | money }}</div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_view_all and selected_collection != blank -%}
      <div style="text-align:center; margin-top:32px;">
        <a class="jv-button jv-button--ghost" href="{{ selected_collection.url }}">{{ section.settings.view_all_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "JOVAA • Products",
  "tag": "section",
  "class": "jovaa-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "text", "id": "subheading", "label": "English subtitle", "default": "BESTSELLERS" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 5 },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 5, "step": 1, "default": 5 },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show add to cart button", "default": true },
    { "type": "text", "id": "add_to_cart_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "choose_options_label", "label": "Choose options label", "default": "Choose options" },
    { "type": "text", "id": "sale_label", "label": "Sale badge", "default": "Sale" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all link", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" }
  ],
  "presets": [{ "name": "JOVAA • Products" }]
}
{% endschema %}
