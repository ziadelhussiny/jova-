{%- assign selected_collection = section.settings.collection | default: collections.all -%}
{%- assign heading_id = 'JovaaProducts-' | append: section.id -%}
<section class="jv-section jv-section--paper" aria-labelledby="{{ heading_id }}">
  <div class="jv-shell">
    {% render 'jovaa-heading', id: heading_id, eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}

    <div class="jv-grid jv-products" style="--jv-columns: {{ section.settings.columns }};">
      {%- for product in selected_collection.products limit: section.settings.products_to_show -%}
        {%- assign product_image_alt = product.featured_image.alt | default: product.title -%}
        <article class="jv-product" data-jovaa-reveal>
          <div class="jv-product__media">
            {%- if product.featured_image != blank -%}
              {{ product.featured_image
                | image_url: width: 900
                | image_tag:
                  widths: '240, 360, 480, 640, 900',
                  sizes: '(max-width: 749px) calc(50vw - 15px), (max-width: 989px) 33vw, 25vw',
                  loading: 'lazy',
                  alt: product_image_alt
              }}
            {%- else -%}
              <div class="jv-media-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
            {%- endif -%}
            {%- if product.compare_at_price > product.price -%}<span class="jv-product__badge">{{ section.settings.sale_label | escape }}</span>{%- endif -%}
          </div>
          <h3 class="jv-product__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
          <div class="jv-product__price">
            {%- if product.price_varies -%}ابتداءً من {{ product.price_min | money }}{%- else -%}{{ product.price | money }}{%- endif -%}
          </div>
          {%- if section.settings.show_quick_add -%}
            {%- if product.available and product.has_only_default_variant -%}
              {%- form 'product', product -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button class="jv-button" type="submit" name="add">{{ section.settings.add_to_cart_label | escape }}</button>
              {%- endform -%}
            {%- else -%}
              <a class="jv-button" href="{{ product.url }}">{{ section.settings.choose_options_label | escape }}</a>
            {%- endif -%}
          {%- endif -%}
        </article>
      {%- else -%}
        {%- for index in (1..4) -%}
          <article class="jv-product">
            <div class="jv-product__media"><div class="jv-media-placeholder">{{ 'product-' | append: index | placeholder_svg_tag }}</div></div>
            <h3 class="jv-product__title">منتج JOVAA</h3>
            <div class="jv-product__price">{{ 9500 | money }}</div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_view_all and selected_collection != blank -%}
      <div style="text-align:center; margin-top:32px;">
        <a class="jv-button jv-button--ghost" href="{{ selected_collection.url }}">{{ section.settings.view_all_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "JOVAA • Products",
  "tag": "section",
  "class": "jovaa-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "النص الصغير" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "الأكثر مبيعًا" },
    { "type": "text", "id": "subheading", "label": "العنوان الإنجليزي", "default": "BESTSELLERS" },
    { "type": "collection", "id": "collection", "label": "المجموعة" },
    { "type": "range", "id": "products_to_show", "label": "عدد المنتجات", "min": 2, "max": 12, "step": 1, "default": 5 },
    { "type": "range", "id": "columns", "label": "أعمدة سطح المكتب", "min": 2, "max": 5, "step": 1, "default": 5 },
    { "type": "checkbox", "id": "show_quick_add", "label": "إظهار زر الإضافة", "default": true },
    { "type": "text", "id": "add_to_cart_label", "label": "نص زر الإضافة", "default": "أضف للسلة" },
    { "type": "text", "id": "choose_options_label", "label": "نص اختيار الخيارات", "default": "اختر الخيارات" },
    { "type": "text", "id": "sale_label", "label": "شارة التخفيض", "default": "خصم" },
    { "type": "checkbox", "id": "show_view_all", "label": "إظهار عرض الكل", "default": true },
    { "type": "text", "id": "view_all_label", "label": "نص عرض الكل", "default": "عرض الكل" }
  ],
  "presets": [{ "name": "JOVAA • Products" }]
}
{% endschema %}
