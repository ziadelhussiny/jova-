{%- assign heading_id = 'JovaaBenefits-' | append: section.id -%}
<section class="jv-section jv-section--compact" aria-labelledby="{{ heading_id }}">
  <div class="jv-shell">
    {%- if section.settings.heading != blank -%}
      {% render 'jovaa-heading', id: heading_id, eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}
    {%- else -%}
      <h2 class="visually-hidden" id="{{ heading_id }}">{{ section.settings.accessible_title | escape }}</h2>
    {%- endif -%}
    <div class="jv-grid jv-benefits" style="--jv-columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <article class="jv-benefit" {{ block.shopify_attributes }} data-jovaa-reveal>
          {% render 'jovaa-icon', icon: block.settings.icon %}
          <div>
            <h3>{{ block.settings.heading | escape }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JOVAA • Benefits",
  "tag": "section",
  "class": "jovaa-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "accessible_title", "label": "عنوان قارئ الشاشة", "default": "مميزات المتجر" },
    { "type": "text", "id": "eyebrow", "label": "النص الصغير" },
    { "type": "text", "id": "heading", "label": "العنوان" },
    { "type": "text", "id": "subheading", "label": "العنوان الإنجليزي" },
    { "type": "range", "id": "columns", "label": "عدد الأعمدة", "min": 2, "max": 6, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "benefit", "name": "ميزة",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "الأيقونة", "default": "badge",
          "options": [
            { "value": "badge", "label": "أصلي" }, { "value": "truck", "label": "توصيل" },
            { "value": "card", "label": "دفع" }, { "value": "box", "label": "طلب" },
            { "value": "globe", "label": "عالمي" }, { "value": "diamond", "label": "فاخر" },
            { "value": "shield", "label": "حماية" }, { "value": "heart", "label": "قلب" }
          ]
        },
        { "type": "text", "id": "heading", "label": "العنوان", "default": "منتجات أصلية 100%" },
        { "type": "text", "id": "text", "label": "الوصف", "default": "مضمونة من الماركات العالمية" }
      ]
    }
  ],
  "presets": [
    {
      "name": "JOVAA • Benefits",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit", "settings": { "icon": "truck", "heading": "توصيل لجميع أنحاء مصر", "text": "سريع وموثوق" } },
        { "type": "benefit", "settings": { "icon": "card", "heading": "دفع آمن", "text": "جميع وسائل الدفع" } },
        { "type": "benefit", "settings": { "icon": "box", "heading": "طلب سهل", "text": "تجربة تسوق مريحة" } }
      ]
    }
  ]
}
{% endschema %}
