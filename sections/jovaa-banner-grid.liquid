{%- assign heading_id = 'JovaaBanners-' | append: section.id -%}
<section{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handleize }}"{% endif %} class="jv-section jv-section--compact" aria-labelledby="{{ heading_id }}">
  <div class="jv-shell">
    {%- if section.settings.heading != blank -%}
      {% render 'jovaa-heading', id: heading_id, eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}
    {%- else -%}
      <h2 class="visually-hidden" id="{{ heading_id }}">{{ section.settings.accessible_title | escape }}</h2>
    {%- endif -%}
    <div class="jv-grid jv-banners" style="--jv-columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        {%- assign banner_alt = block.settings.image.alt | default: block.settings.heading -%}
        <article class="jv-banner" {{ block.shopify_attributes }} data-jovaa-reveal>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image
              | image_url: width: 1600
              | image_tag:
                widths: '480, 720, 960, 1200, 1600',
                sizes: '(max-width: 749px) 100vw, 50vw',
                loading: 'lazy',
                alt: banner_alt
            }}
          {%- else -%}
            <div class="jv-media-placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
          {%- endif -%}
          <div class="jv-banner__content">
            {%- if block.settings.eyebrow != blank -%}<span class="jv-hero__eyebrow">{{ block.settings.eyebrow | escape }}</span>{%- endif -%}
            <h3>{{ block.settings.heading | escape }}</h3>
            {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="jv-button jv-button--light" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JOVAA • Banners",
  "tag": "section",
  "class": "jovaa-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "معرّف الرابط الداخلي" },
    { "type": "text", "id": "accessible_title", "label": "عنوان قارئ الشاشة", "default": "اكتشف مجموعاتنا" },
    { "type": "text", "id": "eyebrow", "label": "النص الصغير" },
    { "type": "text", "id": "heading", "label": "العنوان" },
    { "type": "text", "id": "subheading", "label": "العنوان الإنجليزي" },
    { "type": "range", "id": "columns", "label": "عدد الأعمدة", "min": 1, "max": 3, "step": 1, "default": 2 }
  ],
  "blocks": [
    {
      "type": "banner", "name": "بانر",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "الصورة" },
        { "type": "text", "id": "eyebrow", "label": "النص الصغير", "default": "A SCENT, A BETTER YOU" },
        { "type": "text", "id": "heading", "label": "العنوان", "default": "اكتشفي مجموعتنا الحصرية" },
        { "type": "richtext", "id": "text", "label": "الوصف" },
        { "type": "text", "id": "button_label", "label": "نص الزر", "default": "تسوق الآن" },
        { "type": "url", "id": "link", "label": "الرابط" }
      ]
    }
  ],
  "presets": [
    {
      "name": "JOVAA • Banners",
      "blocks": [
        { "type": "banner" },
        { "type": "banner", "settings": { "eyebrow": "TIMELESS ELEGANCE", "heading": "حقائب أصلية تكمل إطلالتك", "button_label": "تسوق الحقائب" } }
      ]
    }
  ]
}
{% endschema %}
