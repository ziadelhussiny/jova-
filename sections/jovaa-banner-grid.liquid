{%- assign heading_id = 'JovaaBanners-' | append: section.id -%}
<section{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handleize }}"{% endif %} class="jv-section jv-section--compact" aria-labelledby="{{ heading_id }}">
  <div class="jv-shell">
    {%- if section.settings.heading != blank -%}
      {% render 'jovaa-heading', id: heading_id, eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}
    {%- else -%}
      <h2 class="visually-hidden" id="{{ heading_id }}">{{ section.settings.accessible_title | escape }}</h2>
    {%- endif -%}
    <div class="jv-grid jv-banners" style="--jv-columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        {%- assign banner_alt = block.settings.image.alt | default: block.settings.heading -%}
        {%- assign fallback_asset = 'jovaa-editorial.webp' -%}
        {%- assign fallback_mobile_asset = 'jovaa-editorial-mobile.webp' -%}
        {%- case block.settings.fallback_image -%}
          {%- when 'handbag' -%}{%- assign fallback_asset = 'jovaa-handbag.webp' -%}{%- assign fallback_mobile_asset = 'jovaa-handbag-mobile.webp' -%}
          {%- when 'perfume' -%}{%- assign fallback_asset = 'jovaa-perfume.webp' -%}{%- assign fallback_mobile_asset = 'jovaa-perfume-mobile.webp' -%}
          {%- when 'cairo' -%}{%- assign fallback_asset = 'jovaa-cairo.webp' -%}{%- assign fallback_mobile_asset = 'jovaa-cairo-mobile.webp' -%}
        {%- endcase -%}
        <article class="jv-banner jv-banner--{{ block.settings.content_position }}" {{ block.shopify_attributes }} data-jovaa-reveal>
          {%- if block.settings.image != blank -%}
            <picture>
              {%- if block.settings.mobile_image != blank -%}
                <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 480 }} 480w, {{ block.settings.mobile_image | image_url: width: 750 }} 750w" sizes="100vw">
              {%- endif -%}
              {{ block.settings.image
                | image_url: width: 1600
                | image_tag:
                  widths: '480, 720, 960, 1200, 1600',
                  sizes: '(max-width: 749px) 100vw, 50vw',
                  loading: 'lazy',
                  alt: banner_alt
              }}
            </picture>
          {%- else -%}
            {% render 'jovaa-fallback-image', image: fallback_asset, mobile_image: fallback_mobile_asset, alt: banner_alt, sizes: '(max-width: 749px) 100vw, 50vw' %}
          {%- endif -%}
          <div class="jv-banner__content">
            {%- if block.settings.eyebrow != blank -%}<span class="jv-hero__eyebrow">{{ block.settings.eyebrow | escape }}</span>{%- endif -%}
            <h3>{{ block.settings.heading | escape }}</h3>
            {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="jv-button jv-button--light" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JOVAA • Banners",
  "tag": "section",
  "class": "jovaa-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "text", "id": "accessible_title", "label": "Accessible title", "default": "Discover our collections" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "English subtitle" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 1, "max": 3, "step": 1, "default": 2 }
  ],
  "blocks": [
    {
      "type": "banner", "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        {
          "type": "select", "id": "fallback_image", "label": "Built-in fallback image", "default": "editorial",
          "options": [
            { "value": "editorial", "label": "Editorial model" }, { "value": "handbag", "label": "Handbag" },
            { "value": "perfume", "label": "Perfume" }, { "value": "cairo", "label": "Cairo" }
          ]
        },
        {
          "type": "select", "id": "content_position", "label": "Content position", "default": "start",
          "options": [{ "value": "start", "label": "Start" }, { "value": "end", "label": "End" }]
        },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "A SCENT, A BETTER YOU" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Discover our exclusive collection" },
        { "type": "richtext", "id": "text", "label": "Description" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "JOVAA • Banners",
      "blocks": [
        { "type": "banner" },
        { "type": "banner", "settings": { "eyebrow": "TIMELESS ELEGANCE", "heading": "Timeless bags for every look", "button_label": "Shop handbags" } }
      ]
    }
  ]
}
{% endschema %}
