{%- assign heading_id = 'JovaaFaq-' | append: section.id -%}
<section class="jv-section jv-section--compact" aria-labelledby="{{ heading_id }}">
  <div class="jv-shell">
    {% render 'jovaa-heading', id: heading_id, eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}
    <div class="jv-grid jv-faq-links" style="--jv-columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <a class="jv-faq-card" href="{{ block.settings.link | default: routes.root_url }}" {{ block.shopify_attributes }} data-jovaa-reveal>
          {% render 'jovaa-icon', icon: block.settings.icon %}
          <h3>{{ block.settings.heading | escape }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JOVAA • FAQ links",
  "tag": "section",
  "class": "jovaa-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "النص الصغير" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "الأسئلة الشائعة" },
    { "type": "text", "id": "subheading", "label": "العنوان الإنجليزي", "default": "FAQ QUICK LINKS" },
    { "type": "range", "id": "columns", "label": "عدد الأعمدة", "min": 2, "max": 6, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "link", "name": "رابط",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "الأيقونة", "default": "box",
          "options": [{ "value": "box", "label": "شحن" }, { "value": "badge", "label": "أصلي" }, { "value": "card", "label": "دفع" }, { "value": "return", "label": "إرجاع" }]
        },
        { "type": "text", "id": "heading", "label": "العنوان", "default": "الشحن والتوصيل" },
        { "type": "text", "id": "text", "label": "الوصف", "default": "معلومات عن التوصيل والمحافظات" },
        { "type": "url", "id": "link", "label": "الرابط" }
      ]
    }
  ],
  "presets": [
    {
      "name": "JOVAA • FAQ links",
      "blocks": [
        { "type": "link" },
        { "type": "link", "settings": { "icon": "badge", "heading": "المنتجات الأصلية", "text": "كيف نضمن المنتجات الأصلية" } },
        { "type": "link", "settings": { "icon": "card", "heading": "الدفع والطلبات", "text": "طرق الدفع وتأكيد الطلبات" } },
        { "type": "link", "settings": { "icon": "return", "heading": "الإرجاع والاستبدال", "text": "سياسة الإرجاع والاستبدال" } }
      ]
    }
  ]
}
{% endschema %}
