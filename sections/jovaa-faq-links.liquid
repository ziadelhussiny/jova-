{%- assign heading_id = 'JovaaFaq-' | append: section.id -%}
<section class="jv-section jv-section--compact" aria-labelledby="{{ heading_id }}">
  <div class="jv-shell">
    {% render 'jovaa-heading', id: heading_id, eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}
    <div class="jv-grid jv-faq-links" style="--jv-columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <a class="jv-faq-card" href="{{ block.settings.link | default: routes.root_url }}" {{ block.shopify_attributes }} data-jovaa-reveal>
          {% render 'jovaa-icon', icon: block.settings.icon %}
          <h3>{{ block.settings.heading | escape }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JOVAA • FAQ links",
  "tag": "section",
  "class": "jovaa-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "text", "id": "subheading", "label": "English subtitle", "default": "FAQ QUICK LINKS" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 6, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "link", "name": "Link",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "box",
          "options": [{ "value": "box", "label": "Shipping" }, { "value": "badge", "label": "Authenticity" }, { "value": "card", "label": "Payment" }, { "value": "return", "label": "Returns" }]
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping and delivery" },
        { "type": "text", "id": "text", "label": "Description", "default": "Delivery information and coverage" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "JOVAA • FAQ links",
      "blocks": [
        { "type": "link" },
        { "type": "link", "settings": { "icon": "badge", "heading": "Authentic products", "text": "How we verify authenticity" } },
        { "type": "link", "settings": { "icon": "card", "heading": "Payments and orders", "text": "Payment methods and order confirmation" } },
        { "type": "link", "settings": { "icon": "return", "heading": "Returns and exchanges", "text": "Our return and exchange policy" } }
      ]
    }
  ]
}
{% endschema %}
