{%- assign heading_id = 'JovaaTimeline-' | append: section.id -%}
<section class="jv-section jv-section--paper" aria-labelledby="{{ heading_id }}">
  <div class="jv-shell">
    {% render 'jovaa-heading', id: heading_id, eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}
    <div class="jv-grid jv-timeline" style="--jv-columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <article class="jv-timeline__item" {{ block.shopify_attributes }} data-jovaa-reveal>
          <div class="jv-timeline__marker">{% render 'jovaa-icon', icon: block.settings.icon %}</div>
          <div>
            <h3>{{ block.settings.year | escape }}{% if block.settings.heading != blank %} — {{ block.settings.heading | escape }}{% endif %}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JOVAA • Timeline",
  "tag": "section",
  "class": "jovaa-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our journey" },
    { "type": "text", "id": "subheading", "label": "English subtitle", "default": "OUR JOURNEY" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 6, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "milestone", "name": "Milestone",
      "settings": [
        { "type": "text", "id": "year", "label": "Year", "default": "2023" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "The beginning" },
        { "type": "text", "id": "text", "label": "Description", "default": "JOVAA launches in Egypt" },
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "store",
          "options": [{ "value": "store", "label": "Store" }, { "value": "people", "label": "Customers" }, { "value": "box", "label": "Products" }, { "value": "diamond", "label": "Vision" }]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JOVAA • Timeline",
      "blocks": [
        { "type": "milestone" },
        { "type": "milestone", "settings": { "year": "2024", "heading": "Thousands of customers", "text": "A growing community of luxury lovers", "icon": "people" } },
        { "type": "milestone", "settings": { "year": "2024–2025", "heading": "Growth and discovery", "text": "A wider edit of global brands", "icon": "box" } },
        { "type": "milestone", "settings": { "year": "The future", "heading": "A brighter future", "text": "Continuing our journey to remain your first destination", "icon": "diamond" } }
      ]
    }
  ]
}
{% endschema %}
