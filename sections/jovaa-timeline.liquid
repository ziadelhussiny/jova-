{%- assign heading_id = 'JovaaTimeline-' | append: section.id -%}
<section class="jv-section jv-section--paper" aria-labelledby="{{ heading_id }}">
  <div class="jv-shell">
    {% render 'jovaa-heading', id: heading_id, eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}
    <div class="jv-grid jv-timeline" style="--jv-columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <article class="jv-timeline__item" {{ block.shopify_attributes }} data-jovaa-reveal>
          <div class="jv-timeline__marker">{% render 'jovaa-icon', icon: block.settings.icon %}</div>
          <div>
            <h3>{{ block.settings.year | escape }}{% if block.settings.heading != blank %} — {{ block.settings.heading | escape }}{% endif %}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JOVAA • Timeline",
  "tag": "section",
  "class": "jovaa-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "النص الصغير" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "رحلتنا في أرقام" },
    { "type": "text", "id": "subheading", "label": "العنوان الإنجليزي", "default": "OUR JOURNEY" },
    { "type": "range", "id": "columns", "label": "عدد الأعمدة", "min": 2, "max": 6, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "milestone", "name": "محطة",
      "settings": [
        { "type": "text", "id": "year", "label": "السنة", "default": "2023" },
        { "type": "text", "id": "heading", "label": "العنوان", "default": "بداية الرحلة" },
        { "type": "text", "id": "text", "label": "الوصف", "default": "انطلاق JOVAA في مصر" },
        {
          "type": "select", "id": "icon", "label": "الأيقونة", "default": "store",
          "options": [{ "value": "store", "label": "متجر" }, { "value": "people", "label": "عملاء" }, { "value": "box", "label": "منتجات" }, { "value": "diamond", "label": "طموح" }]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JOVAA • Timeline",
      "blocks": [
        { "type": "milestone" },
        { "type": "milestone", "settings": { "year": "2024", "heading": "آلاف العملاء", "text": "بناء مجتمع من محبي الفخامة", "icon": "people" } },
        { "type": "milestone", "settings": { "year": "2024–2025", "heading": "توسع وتنوع", "text": "المزيد من الماركات العالمية", "icon": "box" } },
        { "type": "milestone", "settings": { "year": "المستقبل", "heading": "أكثر إشراقًا", "text": "مواصلة رحلتنا لنكون دائمًا وجهتك الأولى", "icon": "diamond" } }
      ]
    }
  ]
}
{% endschema %}
